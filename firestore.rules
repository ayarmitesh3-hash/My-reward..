rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Test mode only: do not use for real-value rewards.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'testCoins', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.testCoins == 0;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['testCoins', 'lastTx'])
        && request.resource.data.testCoins is int
        && request.resource.data.testCoins >= 0
        && request.resource.data.testCoins <= resource.data.testCoins + 100;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['banned']);

      allow delete: if false;

      match /tx/{txId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100;
        allow update, delete: if false;
      }
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /codes/{codeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
